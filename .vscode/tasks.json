{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start FastAPI Backend",
            "type": "shell",
            "command": "python",
            "args": ["-m", "uvicorn", "main:app", "--reload", "--host", "localhost", "--port", "8000"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Uvicorn running on.*$",
                    "endsPattern": "^.*Application startup complete.*$"
                }
            }
        },
        {
            "label": "Start Frontend Server",
            "type": "shell",
            "command": "python",
            "args": ["-m", "http.server", "3000", "--bind", "localhost"],
            "options": {
                "cwd": "${workspaceFolder}/app"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Serving HTTP on.*$",
                    "endsPattern": "^.*Serving HTTP on.*$"
                }
            }
        },
        {
            "label": "Install Python Dependencies",
            "type": "shell",
            "command": "python",
            "args": ["-m", "pip", "install", "-r", "requirements.txt"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "Reset Test Data",
            "type": "shell",
            "command": "curl",
            "args": ["-X", "POST", "http://localhost:8000/api/reset-data"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "Check Backend Health",
            "type": "shell",
            "command": "curl",
            "args": ["http://localhost:8000/health"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        }
    ]
}
